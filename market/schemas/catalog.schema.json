{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generation", "generatedAt", "expiresAt", "entries", "revocations"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "candidate"},
    "generation": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string"}, "expiresAt": {"type": "string"},
    "revocations": {"type": "object", "additionalProperties": false, "required": ["works", "builds"], "properties": {
      "works": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "builds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "size", "sha256", "url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "releaseId", "tag", "checker", "identity", "assets"],
      "properties": {
        "version": {"type": "string"}, "releaseId": {"type": "integer", "minimum": 1},
        "tag": {"type": "string"}, "checker": {"const": "market-metadata/1"},
        "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "repositoryId", "ownerId", "repository", "workId", "title", "sdk", "capabilities", "attribution", "status", "firstListedAt", "build", "history"],
      "properties": {
        "key": {"type": "string"}, "repositoryId": {"type": "integer", "minimum": 1},
        "ownerId": {"type": "integer", "minimum": 1}, "repository": {"type": "string"},
        "workId": {"type": "string"}, "title": {"type": "string"}, "sdk": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "attribution": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "githubUserId", "license"],
          "properties": {"name": {"type": "string"}, "githubUserId": {"type": "integer", "minimum": 1}, "license": {"type": "string"}}
        }},
        "status": {"enum": ["awaiting-sdk-validation", "revoked"]},
        "firstListedAt": {"type": "string"}, "build": {"$ref": "#/$defs/build"},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/build"}}
      }
    }
  }
}
