{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "repository",
    "workId",
    "revision",
    "packageSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    },
    "workId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
    },
    "packageSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
