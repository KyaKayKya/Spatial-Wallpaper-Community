{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generation",
    "generatedAt",
    "expiresAt",
    "entries",
    "revocations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "published"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "revocations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "works",
        "builds"
      ],
      "properties": {
        "works": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "builds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "maxItems": 4096
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size",
        "sha256",
        "url"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}\\.spatial$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "releaseId",
        "tag",
        "checker",
        "identity",
        "assets"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "releaseId": {
          "type": "integer",
          "minimum": 1
        },
        "tag": {
          "type": "string"
        },
        "checker": {
          "const": "market-metadata/1"
        },
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset"
          },
          "maxItems": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "repositoryId",
        "ownerId",
        "repository",
        "workId",
        "title",
        "sdk",
        "capabilities",
        "attribution",
        "status",
        "firstListedAt",
        "build",
        "history",
        "admission"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1
        },
        "ownerId": {
          "type": "integer",
          "minimum": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
        },
        "workId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "sdk": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "githubUserId",
              "license"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "githubUserId": {
                "type": "integer",
                "minimum": 1
              },
              "license": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "enum": [
            "published",
            "revoked"
          ]
        },
        "firstListedAt": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/build"
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "sdkVersion",
            "sceneCommandAbi",
            "policy",
            "buildIdentity",
            "packageAssetId"
          ],
          "properties": {
            "schemaVersion": {
              "const": 5
            },
            "sdkVersion": {
              "const": "0.4.0-preview.1"
            },
            "sceneCommandAbi": {
              "const": 1
            },
            "policy": {
              "const": "native-admission-v1"
            },
            "buildIdentity": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "packageAssetId": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "description": {
          "type": "string",
          "maxLength": 8000
        },
        "preview": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://(raw\\.githubusercontent\\.com|github\\.com|user-images\\.githubusercontent\\.com)/"
        },
        "discussion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "number"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/discussions/[1-9][0-9]*$"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "popularity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "downloads7d"
          ],
          "properties": {
            "downloads7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url",
            "number"
          ],
          "properties": {
            "kind": {
              "const": "issues"
            },
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
